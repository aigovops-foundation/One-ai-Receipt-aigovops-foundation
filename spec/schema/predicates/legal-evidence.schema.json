{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aigovops-foundation.github.io/One-ai-Receipt-aigovops-foundation/spec/schema/predicates/legal-evidence.schema.json",
  "title": "Legal-evidence predicate 1.0",
  "description": "Optional profile fields that let a receipt travel as evidence. Presence never implies admissibility; the jurisdiction profile says what was done, not what a court will accept.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "jurisdiction_profile",
    "collection_method",
    "collector_identity",
    "timestamp_assurance"
  ],
  "properties": {
    "jurisdiction_profile": {
      "enum": [
        "EU-eIDAS-QTSA",
        "US-FRE-901",
        "CN-online-litigation",
        "UK-CPR-PD57AD",
        "generic"
      ]
    },
    "collection_method": {
      "type": "string",
      "minLength": 1
    },
    "collector_identity": {
      "type": "string",
      "minLength": 1
    },
    "chain_of_custody": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "holder",
          "from"
        ],
        "properties": {
          "holder": {
            "type": "string",
            "minLength": 1
          },
          "from": {
            "type": "string",
            "format": "date-time"
          },
          "to": {
            "type": "string",
            "format": "date-time"
          },
          "transfer_receipt_id": {
            "type": "string",
            "pattern": "^urn:one-receipt:"
          }
        }
      }
    },
    "timestamp_assurance": {
      "enum": [
        "issuer-clock",
        "rfc3161",
        "qualified-time-stamp",
        "log-observed"
      ]
    },
    "verifier_version": {
      "type": "string",
      "minLength": 1
    },
    "evidence_export_manifest": {
      "type": "string",
      "minLength": 1
    },
    "retention_until": {
      "type": "string",
      "format": "date-time"
    }
  }
}